
# Copy this file to `.env` in the backend directory:

PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DB_URL=
DB_USERNAME=root
DB_PASSWORD=

# open     -> Demo/dev mode (no credentials required for general seating engine endpoints)
# enforced -> Production mode (bearer tokens + HTTP Basic + RBAC enforced)
SECURITY_MODE=open

# JWT / Token lifetime in hours
TOKEN_TTL_HOURS=24

# Directory where uploaded files and generated exports are saved
STORAGE_DIR=./data/storage

# Max file upload size for student & room Excel sheets
MAX_UPLOAD_SIZE=25MB

# Set to true only if you want initial mock demo data auto-populated on first boot
SEED_DEMO=false
SEED_USERS=false
SHOW_SQL=false

# Platform Administrator (SaaS Control Plane — /admin-login & /admin)
# Leave PLATFORM_ADMIN_PASSWORD blank to disable the platform admin account.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
