<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         Exam Seating Arrangement Engine — Spring Boot 4 REST API
         Tech stack (mandated): Java 21, Spring Web MVC + Data JPA +
         Spring Security 7, MySQL, Maven, Apache POI, OpenPDF, Lombok.
         ============================================================ -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.examseating</groupId>
    <artifactId>exam-seating-engine</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>exam-seating-engine</name>
    <description>Exam Seating Arrangement Engine — pure Java Spring Boot backend (Step 1: core)</description>

    <properties>
        <!-- Spring Boot 4 requires Java 17+; Java 21 is the mandated LTS baseline. -->
        <java.version>21</java.version>
        <poi.version>5.5.1</poi.version>
        <openpdf.version>2.4.0</openpdf.version>
    </properties>

    <dependencies>

        <!-- Spring Web MVC: REST API layer. Boot 4 renamed this starter from
             spring-boot-starter-web to spring-boot-starter-webmvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Jackson 3 JSON support. The MVC starter already pulls this in, but
             Boot 4's starters are modular, so it is declared explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation) for DTOs: @NotNull/@Min/@Valid ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate 7 (ORM over MySQL) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security 7: authenticates User entity (SecurityFilterChain / @PreAuthorize) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- MySQL JDBC driver (version managed by the Spring Boot 4 BOM) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache POI: Excel (xlsx) generation/parsing for seating sheets.
             5.5.1 fixes the poi-ooxml input-validation advisory present in 5.2.5. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- OpenPDF: printable PDF door notices / invigilator sheets.
             2.4.0 is the newest 2.x line, which keeps the com.lowagie.text API
             used by PdfExportService while refreshing its vulnerable deps. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Lombok: compile-time boilerplate reduction (version managed by Boot 4) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Boot 4 modular test starters. Each one brings spring-boot-starter-test
             transitively and adds the test auto-configuration for its technology.
             spring-boot-starter-webmvc-test supplies @AutoConfigureMockMvc,
             ...data-jpa-test supplies JPA test infrastructure, and
             ...security-test supplies spring-security-test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2: in-memory database for the test suite, so `mvn test` needs no
             MySQL server. Production still runs on MySQL (see
             src/main/resources/application.yml). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
